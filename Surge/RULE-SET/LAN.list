# > Local Area Network & Special-Use Addresses
# 通过 ChatGPT 收集整理
# mDNS 域名后缀（用于局域网设备发现，如打印机、NAS）
DOMAIN-SUFFIX,local
# RFC 1918 私有地址（10/8）
IP-CIDR,10.0.0.0/8,no-resolve
# RFC 1918 私有地址（172.16/12）
IP-CIDR,172.16.0.0/12,no-resolve
# RFC 1918 私有地址（192.168/16）
IP-CIDR,192.168.0.0/16,no-resolve
# 本地回环地址（localhost）
IP-CIDR,127.0.0.0/8,no-resolve
# 链路本地地址（APIPA）
IP-CIDR,169.254.0.0/16,no-resolve
# IPv4 多播地址（包含不同作用域，非全部为局域网）
IP-CIDR,224.0.0.0/4,no-resolve
# IPv4 保留地址（含 255.255.255.255 有限广播地址）
IP-CIDR,240.0.0.0/4,no-resolve
# IPv4 本网络地址（特殊用途，非普通可用子网）
IP-CIDR,0.0.0.0/8,no-resolve
# 运营商共享地址（RFC 6598，非 RFC 1918 私网）
IP-CIDR,100.64.0.0/10,no-resolve
# 网络设备基准测试地址（RFC 2544；部分代理工具借作 Fake IP）
IP-CIDR,198.18.0.0/15,no-resolve
# IPv6 回环地址
IP-CIDR6,::1/128,no-resolve
# IPv6 唯一本地地址（ULA，RFC 4193）
IP-CIDR6,fc00::/7,no-resolve
# IPv6 链路本地地址（Link-Local）
IP-CIDR6,fe80::/10,no-resolve
# IPv6 未指定地址（::；不可作为正常目的地址）
IP-CIDR6,::/128,no-resolve
# IPv6 多播地址（包含不同作用域，非全部为局域网）
IP-CIDR6,ff00::/8,no-resolve
