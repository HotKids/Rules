# Generated by .github/scripts/module_convert.py; edit sync-rules.txt instead.
# Source: https://raw.githubusercontent.com/kokoryh/Sparkle/master/release/surge/module/bilibili.sgmodule
# arguments: 动态最常访问:auto,创作中心:0,过滤置顶评论广告:1,优化评论区加载:bilibili.request,空降助手:bilibili.airborne,空降助手策略:DIRECT,屏蔽P2P:DEST-PORT,日志等级:4
# arguments-desc: 动态最常访问\n- auto: 仅当列表中存在直播状态时显示\n- show: 始终显示\n- hide: 始终隐藏\n\n创作中心\n- 0: 隐藏\n- 1: 显示\n\n过滤置顶评论广告\n- 0: 关闭\n- 1: 开启\n\n优化评论区加载: 默认开启，配置为"#"时关闭\n\n空降助手: 默认开启，配置为"#"时关闭\n\n空降助手策略: 默认直连，建议配置为代理策略\n\n屏蔽P2P: 默认开启，配置为"#"时关闭\n\n日志等级\n- 1: DEBUG\n- 2: INFO\n- 3: WARN\n- 4: ERROR\n- 5: OFF
# Surge arguments use the merged defaults shown above.
name: 哔哩哔哩去广告
desc: 哔哩哔哩去广告，部分 App 需清除缓存或重新安装后才会生效
author: kokoryh
category: 去广告
http:
  mitm:
  - grpc.biliapi.net
  - app.bilibili.com
  - api.bilibili.com
  - api.live.bilibili.com
  - www.bilibili.com
  - line3-h5-mobile-api.biligame.com
  body-rewrite:
  - ^https:\/\/api\.live\.bilibili\.com\/xlive\/open-interface\/v2\/tracker\/conf\? response-jq .data.domains=["wss://tracker.chat.bilibili.com"]
  - ^https:\/\/api\.bilibili\.com\/x\/pd-proxy\/tracker\? response-jq .data[][]?="stun.chat.bilibili.com:3478"
  - ^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\? response-jq del(.data.payment)
  - ^https:\/\/api\.bilibili\.com\/pgc\/page\/channel\? response-jq .data.modules |= map(select(.type != "TIP") | if .type == "BANNER" then .module_data.items |= map(select(.url | startswith("https://www.bilibili.com/blackboard/era/") | not)) else . end)
  mock:
  - match: ^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list\?
    text: '{"code":0,"message":"OK","ttl":1,"data":{"max_time":0,"min_interval":31536000,"pull_interval":31536000,"keep_ids":[],"show":[],"list":[{}],"splash_request_id":""}}'
    status-code: 200
    headers:
      content-type: application/json
  - match: ^https:\/\/ap[ip]\.bilibili\.com\/x\/(?:resource\/(?:top\/activity|patch\/tab(?:\/v2)?)|v2\/search\/square|vip\/ads\/materials)\?
    text: '{"code":-404,"message":"-404","ttl":1,"data":null}'
    status-code: 200
    headers:
      content-type: application/json
  - match: ^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\?
    text: '{"code":0,"data":{"closeType":"close_win","container":[],"showTime":""},"message":"success"}'
    status-code: 200
    headers:
      content-type: application/json
  - match: ^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\?
    text: '{}'
    status-code: 200
    headers:
      content-type: application/json
  - match: ^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material\?
    text: '{"code":0,"message":"success"}'
    status-code: 200
    headers:
      content-type: application/json
  - match: ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus$
    base64: AAAAABMKEQgCEgl0ZWVuYWdlcnMgAioA
    status-code: 200
    headers:
      content-type: application/grpc
      grpc-status: '0'
  - match: ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$
    base64: AAAAACEaHeaQnOe0ouinhumikeOAgeeVquWJp+aIlnVw5Li7KAE=
    status-code: 200
    headers:
      content-type: application/grpc
      grpc-status: '0'
  - match: ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(?:view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(?:PlayPause|ViewEndPage))$
    base64: AAAAAAA=
    status-code: 200
    headers:
      content-type: application/grpc
      grpc-status: '0'
  script:
  - name: Bilibili-bilibili.airborne
    match: ^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$
    type: request
    require-body: true
    binary-mode: true
    max-size: 0
    timeout: 10
    argument: '{"logLevel":"4"}'
    engine: webkit
  - name: Bilibili-bilibili.request
    match: ^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:app\.viewunite\.v1\.View\/View|main\.community\.reply\.v1\.Reply\/MainList)$
    type: request
    require-body: true
    binary-mode: true
    max-size: 0
    timeout: 10
    argument: '{"purifyComment":1,"logLevel":"4"}'
    engine: webkit
  - name: Bilibili-bilibili.skin
    match: ^https:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\?
    type: response
    require-body: true
    max-size: 0
    engine: webkit
  - name: Bilibili-bilibili.live
    match: ^https:\/\/api\.live\.bilibili\.com\/xlive\/(?:app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(?:Room|User))\?
    type: response
    require-body: true
    max-size: 0
    engine: webkit
  - name: Bilibili-bilibili.json
    match: ^https:\/\/app\.bilibili\.com\/x\/(?:resource\/show\/tab\/v2|v2\/(?:splash\/(?:show|event\/list2)|feed\/index(?:\/story)?|account\/(?:mine(?:\/ipad)?|myinfo)))\?
    type: response
    require-body: true
    max-size: 0
    argument: '{"showCreatorHub":0}'
    engine: webkit
  - name: Bilibili-bilibili.webpage
    match: ^https:\/\/www\.bilibili\.com\/blackboard\/era\/.+\.html\?
    type: response
    require-body: true
    max-size: 0
    engine: webkit
  - name: Bilibili-bilibili.protobuf
    match: ^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:app\.(?:show\.v1\.Popular\/Index|dynamic\.v2\.Dynamic\/DynAll|view(?:unite)?\.v1\.View\/(?:View|ViewProgress|RelatesFeed|AIRelateAsync)|playurl\.v1\.PlayURL\/PlayView|playerunite\.v1\.Player\/PlayViewUnite)|polymer\.app\.search\.v1\.Search\/SearchAll|community\.service\.dm\.v1\.DM\/DmView|main\.community\.reply\.v1\.Reply\/MainList|pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$
    type: response
    require-body: true
    binary-mode: true
    max-size: 0
    argument: '{"displayUpList":"auto","purifyComment":1,"sponsorBlock":"bilibili.airborne","logLevel":"4"}'
    engine: webkit
script-providers:
  Bilibili-bilibili.airborne:
    url: https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.request.js
    interval: 86400
  Bilibili-bilibili.request:
    url: https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.request.js
    interval: 86400
  Bilibili-bilibili.skin:
    url: https://raw.githubusercontent.com/kokoryh/Script/master/js/bili-suit-diy.js
    interval: 86400
  Bilibili-bilibili.live:
    url: https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.json.js
    interval: 86400
  Bilibili-bilibili.json:
    url: https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.json.js
    interval: 86400
  Bilibili-bilibili.webpage:
    url: https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/webpage.bilibili.js
    interval: 86400
  Bilibili-bilibili.protobuf:
    url: https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.response.js
    interval: 86400
rules:
- DOMAIN,bsbsb.top,DIRECT
- DOMAIN,api.biliapi.com,REJECT
- DOMAIN,app.biliapi.com,REJECT
- DOMAIN,api.biliapi.net,REJECT
- DOMAIN,app.biliapi.net,REJECT
- AND,((DOMAIN-SUFFIX,chat.bilibili.com), (OR,((DOMAIN-KEYWORD,stun), (DOMAIN-KEYWORD,tracker), (DOMAIN-KEYWORD,p2p)))),REJECT
- DST-PORT,4480,REJECT
- DST-PORT,4483,REJECT
- DST-PORT,8082,REJECT
- DST-PORT,9102,REJECT
