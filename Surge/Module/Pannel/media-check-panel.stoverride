# 原脚本：HotKids & ChatGPT & Claude
# 独立服务卡片：与 Stash 官方 Collapsed Tiles 示例一致。
# 默认放入“流媒体/第三方服务”页面；长按节点时经该节点检测。
# 如需全部显示在首页，将 collapsed 改为 false，并把 mode=collapsed 改为 mode=home。
# 首页模式才启用 notify/proxy 参数；折叠模式不保存跨节点通知基线。
# 统一白色图标搭配品牌底色；不可用或检测异常时显示灰色。
# Gemini：Stash iOS 首页最多 2 秒，失败后匿名文本兜底，总预算 6 秒。
# 日志统一输出到 hotkids-media-check.log；连接时每分钟收集一次。
name: 'Streaming & AI Service Tiles'
desc: 检测流媒体和 AI 服务的可用性：Netflix、Disney+、HBO Max、YouTube Premium、Spotify、TikTok、ChatGPT、Claude、Gemini、Meta AI、Reddit
icon: https://cdn.jsdelivr.net/npm/@lobehub/icons-static-png@latest/light/bilibili-color.png
tiles:
  - name: hotkids-media-check-netflix
    interval: 600
    title: 'Netflix'
    content: 'Loading...'
    icon: 'https://cdn.jsdelivr.net/gh/selfhst/icons/png/netflix-light.png'
    backgroundColor: '#E50914'
    collapsed: true
    url: 'https://www.netflix.com'
    argument: 'service=netflix&mode=collapsed&notify=false&nfprice=true&log=shared'
  - name: hotkids-media-check-disney
    interval: 600
    title: 'Disney+'
    content: 'Loading...'
    icon: 'https://cdn.jsdelivr.net/gh/selfhst/icons/png/disney-plus-light.png'
    backgroundColor: '#113CCF'
    collapsed: true
    url: 'https://www.disneyplus.com'
    argument: 'service=disney&mode=collapsed&notify=false&log=shared'
  - name: hotkids-media-check-hbomax
    interval: 600
    title: 'HBO Max'
    content: 'Loading...'
    icon: 'https://cdn.jsdelivr.net/gh/selfhst/icons/png/hbo-max-light.png'
    backgroundColor: '#191919'
    collapsed: true
    url: 'https://www.hbomax.com'
    argument: 'service=hbomax&mode=collapsed&notify=false&log=shared'
  - name: hotkids-media-check-youtube
    interval: 600
    title: 'YouTube Premium'
    content: 'Loading...'
    icon: 'https://cdn.jsdelivr.net/gh/selfhst/icons/png/youtube-light.png'
    backgroundColor: '#E62117'
    collapsed: true
    url: 'https://www.youtube.com/premium'
    argument: 'service=youtube&mode=collapsed&notify=false&log=shared'
  - name: hotkids-media-check-spotify
    interval: 600
    title: 'Spotify'
    content: 'Loading...'
    icon: 'https://cdn.jsdelivr.net/gh/selfhst/icons/png/spotify-light.png'
    backgroundColor: '#117C39'
    collapsed: true
    url: 'https://www.spotify.com'
    argument: 'service=spotify&mode=collapsed&notify=false&log=shared'
  - name: hotkids-media-check-tiktok
    interval: 600
    title: 'TikTok'
    content: 'Loading...'
    icon: 'https://cdn.jsdelivr.net/gh/selfhst/icons/png/tiktok-light.png'
    backgroundColor: '#191919'
    collapsed: true
    url: 'https://www.tiktok.com/'
    argument: 'service=tiktok&mode=collapsed&notify=false&log=shared'
  - name: hotkids-media-check-chatgpt
    interval: 600
    title: 'ChatGPT'
    content: 'Loading...'
    icon: 'https://raw.githubusercontent.com/StashNetworks/misc/main/collapsed-tiles/img/chatgpt.png'
    backgroundColor: '#0D8A70'
    collapsed: true
    url: 'https://chatgpt.com'
    argument: 'service=chatgpt&mode=collapsed&notify=false&log=shared'
  - name: hotkids-media-check-claude
    interval: 600
    title: 'Claude'
    content: 'Loading...'
    icon: 'https://cdn.jsdelivr.net/gh/selfhst/icons/png/claude-light.png'
    backgroundColor: '#B85C3F'
    collapsed: true
    url: 'https://claude.ai'
    argument: 'service=claude&mode=collapsed&notify=false&log=shared'
  - name: hotkids-media-check-gemini
    interval: 600
    title: 'Gemini'
    content: 'Loading...'
    icon: 'https://cdn.jsdelivr.net/gh/selfhst/icons/png/google-gemini-light.png'
    backgroundColor: '#386EDB'
    collapsed: true
    url: 'https://gemini.google.com'
    argument: 'service=gemini&mode=collapsed&notify=false&geminiapikey=null&log=shared'
  - name: hotkids-media-check-metaai
    interval: 600
    title: 'Meta AI'
    content: 'Loading...'
    icon: 'https://dashboardicons.com/api/icons/external/simpleicons/metaai/dark.png'
    backgroundColor: '#0866FF'
    collapsed: true
    url: 'https://www.meta.ai/'
    argument: 'service=metaai&mode=collapsed&notify=false&log=shared'
  - name: hotkids-media-check-reddit
    interval: 600
    title: 'Reddit'
    content: 'Loading...'
    icon: 'https://cdn.jsdelivr.net/gh/selfhst/icons/png/reddit-light.png'
    backgroundColor: '#D93900'
    collapsed: true
    url: 'https://www.reddit.com'
    argument: 'service=reddit&mode=collapsed&notify=false&log=shared'

cron:
  script:
    - name: hotkids-media-check
      cron: '* * * * *'
      timeout: 5
      argument: 'service=logs'

script-providers:
  hotkids-media-check:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/media-check.js?v=2.2.10
    interval: 86400
  hotkids-media-check-netflix:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/media-check.js?v=2.2.10
    interval: 86400
  hotkids-media-check-disney:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/media-check.js?v=2.2.10
    interval: 86400
  hotkids-media-check-hbomax:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/media-check.js?v=2.2.10
    interval: 86400
  hotkids-media-check-youtube:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/media-check.js?v=2.2.10
    interval: 86400
  hotkids-media-check-spotify:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/media-check.js?v=2.2.10
    interval: 86400
  hotkids-media-check-tiktok:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/media-check.js?v=2.2.10
    interval: 86400
  hotkids-media-check-chatgpt:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/media-check.js?v=2.2.10
    interval: 86400
  hotkids-media-check-claude:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/media-check.js?v=2.2.10
    interval: 86400
  hotkids-media-check-gemini:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/media-check.js?v=2.2.10
    interval: 86400
  hotkids-media-check-metaai:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/media-check.js?v=2.2.10
    interval: 86400
  hotkids-media-check-reddit:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/media-check.js?v=2.2.10
    interval: 86400
