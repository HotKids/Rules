# 图标来源：Koolson/Qure https://github.com/Koolson/Qure
# 与 Surge 共用 ip-security.js，三张卡片默认折叠到第三方服务 / 流媒体页面。
# 每 600 秒刷新；仅出口卡片通知 IP 变化，首次检测只记录基线。
# 本地卡片显示直连公网 IP。
# 支持首页 Tile 的客户端可改为 collapsed: false 和 mode=home，通知规则相同。
name: 'IP Security Tiles'
desc: 检测出口 IP、本地 IP 和 IP 纯净度（风险与类型），支持刷新时通知 IP 变化
icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Lock.png
tiles:
  - name: hotkids-ip-security-outbound
    interval: 600
    title: '出口 IP'
    url: 'https://ipinfo.io'
    content: 'Waiting…'
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Global.png'
    backgroundColor: '#9E9E9E'
    collapsed: true
    argument: 'tile=outbound&mode=collapsed&notify=true'
  - name: hotkids-ip-security-local
    interval: 600
    title: '本地 IP'
    url: 'https://ipinfo.io'
    content: 'Waiting…'
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Domestic.png'
    backgroundColor: '#9E9E9E'
    collapsed: true
    argument: 'tile=local&mode=collapsed&notify=true'
  - name: hotkids-ip-security-risk
    interval: 600
    title: 'IP 纯净度'
    url: 'https://ippure.com'
    content: 'Waiting…'
    icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Hijacking.png'
    backgroundColor: '#9E9E9E'
    collapsed: true
    argument: 'tile=risk&mode=collapsed&notify=true'

script-providers:
  hotkids-ip-security-outbound:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/ip-security.js?v=6.2.3
    interval: 86400
  hotkids-ip-security-local:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/ip-security.js?v=6.2.3
    interval: 86400
  hotkids-ip-security-risk:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/ip-security.js?v=6.2.3
    interval: 86400
