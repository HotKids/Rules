# 图标：IPPure / selfh.st
# 覆写的 category/icon 及兼容参数默认值由同名 .sgmodule 同步，在 Surge 源文件维护。
# 与 Surge 共用 ip-security.js，首页聚合卡片与三张独立折叠卡片并存。
# 每 600 秒刷新；独立定时任务通知 IP 变化，首次检测只记录基线。
# 通知展示本地/出口 IP、地区、运营商和风险，排版与 Surge 一致。
# 本地卡片显示直连公网 IP；首页及纯净度卡按风险值动态变色，六档等级与 Surge 一致。
# 地区与运营商每轮查询，回退顺序对齐 Surge；出口运营商优先 ipinfo，折叠卡片也查询。
# 首页补充 DNS 解析器与 rDNS；DNS 查询最多等待 1.5 秒，rDNS 复用运营商查询，打码时隐藏。
# 数据源、凭据、打码、旗帜参数取 Surge 声明的默认值；risk_api=null 在 Stash 使用 IPPure。
# notify 默认值用于定时任务，卡片保持关闭通知；不搬入 Surge 专用的事件延迟/点击打码参数。
# 可选值及 ipqs_key / maxmind_key 说明见脚本头部；默认使用不需要密钥。
# 首页聚合卡片需客户端支持首页 Tile；通知独立于卡片。
# 卡片与通知日志统一收集到 hotkids-ip-security.log，最多延迟一分钟。
# v6.4.10：更新覆写后统一刷新各脚本来源，避免旧版本缓存。
name: 'IP Security Tiles'
desc: 首页 IP 信息卡与出口、本地、纯净度折叠卡片，支持定时通知 IP 变化
category: 'HotKids'
icon: 'https://cdn.jsdelivr.net/gh/selfhst/icons@main/png/arrmatey.png'
tiles:
  - name: hotkids-ip-security-summary
    interval: 600
    title: 'IP 信息卡'
    url: 'https://ippure.com'
    content: 'Loading...'
    icon: 'https://ippure.com/logo.png'
    backgroundColor: '#9E9E9E'
    collapsed: false
    argument: 'tile=summary&mode=home&notify=false&log=shared&risk_api=null&local_geoapi=baidu&remote_geoapi=ipapi-zh&ipqs_key=null&maxmind_key=null&mask_ip=0&tw_flag=cn'
  - name: hotkids-ip-security-outbound
    interval: 600
    title: '出口 IP'
    url: 'https://ippure.com'
    content: 'Loading...'
    icon: 'https://cdn.jsdelivr.net/gh/selfhst/icons@main/png/drasl-light.png'
    backgroundColor: '#9E9E9E'
    collapsed: true
    argument: 'tile=outbound&mode=collapsed&notify=false&log=shared&risk_api=null&local_geoapi=baidu&remote_geoapi=ipapi-zh&ipqs_key=null&maxmind_key=null&mask_ip=0&tw_flag=cn'
  - name: hotkids-ip-security-local
    interval: 600
    title: '本地 IP'
    url: 'https://ippure.com'
    content: 'Loading...'
    icon: 'https://cdn.jsdelivr.net/gh/selfhst/icons/png/target-light.png'
    backgroundColor: '#9E9E9E'
    collapsed: true
    argument: 'tile=local&mode=collapsed&notify=false&log=shared&risk_api=null&local_geoapi=baidu&remote_geoapi=ipapi-zh&ipqs_key=null&maxmind_key=null&mask_ip=0&tw_flag=cn'
  - name: hotkids-ip-security-risk
    interval: 600
    title: 'IP 纯净度'
    url: 'https://ippure.com'
    content: 'Loading...'
    icon: 'https://cdn.jsdelivr.net/gh/selfhst/icons@main/png/adguard-home-central-manager-light.png'
    backgroundColor: '#9E9E9E'
    collapsed: true
    argument: 'tile=risk&mode=collapsed&notify=false&log=shared&risk_api=null&local_geoapi=baidu&remote_geoapi=ipapi-zh&ipqs_key=null&maxmind_key=null&mask_ip=0&tw_flag=cn'

# 通知使用日常分流，不受长按测试节点影响；需要 Stash 保持连接。
cron:
  script:
    - name: hotkids-ip-security
      cron: '* * * * *'
      timeout: 5
      argument: 'task=logs'
    - name: hotkids-ip-security-notify
      cron: '*/10 * * * *'
      timeout: 25
      argument: 'task=monitor&notify=true&log=shared&risk_api=null&local_geoapi=baidu&remote_geoapi=ipapi-zh&ipqs_key=null&maxmind_key=null&mask_ip=0&tw_flag=cn'

script-providers:
  hotkids-ip-security:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/ip-security.js?v=6.4.13
    interval: 86400
  hotkids-ip-security-summary:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/ip-security.js?v=6.4.13
    interval: 86400
  hotkids-ip-security-outbound:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/ip-security.js?v=6.4.13
    interval: 86400
  hotkids-ip-security-local:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/ip-security.js?v=6.4.13
    interval: 86400
  hotkids-ip-security-risk:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/ip-security.js?v=6.4.13
    interval: 86400
  hotkids-ip-security-notify:
    url: https://raw.githubusercontent.com/HotKids/Rules/master/Surge/Module/Scripts/ip-security.js?v=6.4.13
    interval: 86400
