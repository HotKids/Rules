# 图标：IPPure / selfh.st
# 覆写的 category/icon 及兼容参数默认值由同名 .sgmodule 同步，在 Surge 源文件维护。
# 与 Surge 共用 ip-security.js，首页聚合卡片与三张独立折叠卡片并存。
# 卡片间隔按 Surge 的 panel_interval 默认值同步为整数，默认 600 秒；首次检测只记录通知基线。
# 通知展示本地/出口 IP、地区、运营商和风险，排版与 Surge 一致。
# 本地卡片显示直连公网 IP；首页及纯净度卡按风险值动态变色，六档等级与 Surge 一致。
# 地区每轮查询：本地百度 → bilibili → ip.sb；出口 ipapi-zh → ipapi → ipinfo。
# local_geoapi / remote_geoapi 指定首选，失败后尝试剩余来源；出口运营商始终优先 ipinfo。
# 首页补充 DNS 解析器与 rDNS；DNS 查询最多等待 1.5 秒，rDNS 复用运营商查询，打码时隐藏。
# 免密钥数据源、打码、旗帜参数取 Surge 默认值；Stash 不使用 IPQS/MaxMind，凭据不随源文件同步。
# risk_api=null 在 Stash 按 IPPure → ProxyCheck → Scamalytics 回退，指定源失败后尝试其余来源。
# notify 默认值用于定时任务，卡片保持关闭通知；event_delay 和点击切换打码仅适用于 Surge。
# Stash 可选 risk_api=ippure/proxycheck/scamalytics；local_geoapi=baidu/bilibili/ipsb；remote_geoapi=ipapi-zh/ipapi/ipinfo/ippure。
# 首页聚合卡片需客户端支持首页 Tile；通知独立于卡片。
# 支持覆写参数的客户端可调整数据源、打码和通知；设备上的选择独立于同步的默认值。
# 卡片 interval 保持整数，以兼容不会展开覆写参数的客户端，不在参数表单中提供。
# 本机 API 默认关闭。需在“外部访问”启用控制接口并填写实际地址/密钥；仅首页和通知调用。
# API 显示的是出口探测域名的规则预测，不代表其他服务线路；接口不支持或失败则省略相关信息。
# 卡片与通知日志统一收集到 hotkids-ip-security.log，最多延迟一分钟。
name: 'IP Security Tiles'
desc: 首页 IP 信息卡与出口、本地、纯净度折叠卡片，支持定时通知 IP 变化
category: 'HotKids'
icon: 'https://cdn.jsdelivr.net/gh/selfhst/icons@main/png/arrmatey.png'
arguments-version: 1
arguments:
  risk_api:
    type: select
    title: 风险评分来源（risk_api）
    description: 自动：IPPure → ProxyCheck → Scamalytics；指定来源优先，失败后尝试其余来源。Stash 仅使用免密钥服务。
    default: 'null'
    options:
    - value: 'null'
      label: 自动回退
    - value: ippure
      label: ippure
    - value: proxycheck
      label: proxycheck
    - value: scamalytics
      label: scamalytics
  local_geoapi:
    type: select
    title: 本地地区首选（local_geoapi）
    description: 默认：百度 → bilibili → ip.sb；指定来源优先，失败后按默认顺序尝试其余来源。百度提供中文省市区，bilibili 为中文，ip.sb 为英文。
    default: baidu
    options:
    - value: baidu
      label: baidu
    - value: bilibili
      label: bilibili
    - value: ipsb
      label: ipsb
  remote_geoapi:
    type: select
    title: 出口地区首选（remote_geoapi）
    description: 出口默认：ipapi-zh → ipapi → ipinfo；指定来源优先。ipapi-zh/ipapi 为同一接口的中英文，使用 HTTP；ipinfo 为英文，IPPure 为额外可选源。运营商优先 ipinfo，缺失时回退到地区来源。
    default: ipapi-zh
    options:
    - value: ipapi-zh
      label: ipapi-zh
    - value: ipapi
      label: ipapi
    - value: ipinfo
      label: ipinfo
    - value: ippure
      label: ippure
  mask_ip:
    type: select
    title: IP 打码（mask_ip）
    description: 0 关闭；1 部分打码；2 全部隐藏。用于卡片和通知；Stash 不支持 Surge 的点击切换打码。
    default: '0'
    options:
    - value: '0'
      label: 关闭
    - value: '1'
      label: 部分打码
    - value: '2'
      label: 全部隐藏
  tw_flag:
    type: select
    title: 台湾地区旗帜（tw_flag）
    description: cn 显示 🇨🇳，tw 显示 🇹🇼。
    default: cn
    options:
    - value: cn
      label: 🇨🇳
    - value: tw
      label: 🇹🇼
  notify:
    type: switch
    title: IP 变化通知（notify）
    description: 每 10 分钟检查本地/出口 IP，变化时通知；首次只记录。Stash 使用定时检查，不使用 Surge 的网络变化事件延迟。独立卡片不触发通知。
    default: true
  stash_api:
    type: switch
    title: 显示本机 API 信息
    default: false
    description: 可选：显示出口探测域名的规则预测和本机累计流量。需在 Stash 启用外部控制，仅用于首页和通知。
  stash_api_url:
    type: input
    title: 本机 API 地址
    default: http://127.0.0.1:9090
    description: 按客户端控制端口填写，仅接受 127.0.0.1、localhost 或 [::1]。
  stash_api_secret:
    type: input
    title: 本机 API 密钥
    default: ''
    description: 填写 Stash 控制接口密钥；留空则不调用 API。不是第三方服务 API Key。
tiles:
  - name: hotkids-ip-security-summary
    interval: 600
    title: 'IP 信息卡'
    url: 'https://ippure.com'
    content: 'Loading...'
    icon: 'https://ippure.com/logo.png'
    backgroundColor: '#9E9E9E'
    collapsed: false
    argument: 'tile=summary&mode=home&notify=false&log=shared&risk_api=null&local_geoapi=baidu&remote_geoapi=ipapi-zh&mask_ip=0&tw_flag=cn&stash_options={"risk_api":${args.risk_api|json},"local_geoapi":${args.local_geoapi|json},"remote_geoapi":${args.remote_geoapi|json},"mask_ip":${args.mask_ip|json},"tw_flag":${args.tw_flag|json},"stash_api":${args.stash_api|json},"stash_api_url":${args.stash_api_url|json},"stash_api_secret":${args.stash_api_secret|json}}'
  - name: hotkids-ip-security-outbound
    interval: 600
    title: '出口 IP'
    url: 'https://ippure.com'
    content: 'Loading...'
    icon: 'https://cdn.jsdelivr.net/gh/selfhst/icons@main/png/drasl-light.png'
    backgroundColor: '#9E9E9E'
    collapsed: true
    argument: 'tile=outbound&mode=collapsed&notify=false&log=shared&risk_api=null&local_geoapi=baidu&remote_geoapi=ipapi-zh&mask_ip=0&tw_flag=cn&stash_options={"risk_api":${args.risk_api|json},"local_geoapi":${args.local_geoapi|json},"remote_geoapi":${args.remote_geoapi|json},"mask_ip":${args.mask_ip|json},"tw_flag":${args.tw_flag|json}}'
  - name: hotkids-ip-security-local
    interval: 600
    title: '本地 IP'
    url: 'https://ippure.com'
    content: 'Loading...'
    icon: 'https://cdn.jsdelivr.net/gh/selfhst/icons/png/target-light.png'
    backgroundColor: '#9E9E9E'
    collapsed: true
    argument: 'tile=local&mode=collapsed&notify=false&log=shared&risk_api=null&local_geoapi=baidu&remote_geoapi=ipapi-zh&mask_ip=0&tw_flag=cn&stash_options={"risk_api":${args.risk_api|json},"local_geoapi":${args.local_geoapi|json},"remote_geoapi":${args.remote_geoapi|json},"mask_ip":${args.mask_ip|json},"tw_flag":${args.tw_flag|json}}'
  - name: hotkids-ip-security-risk
    interval: 600
    title: 'IP 纯净度'
    url: 'https://ippure.com'
    content: 'Loading...'
    icon: 'https://cdn.jsdelivr.net/gh/selfhst/icons@main/png/adguard-home-central-manager-light.png'
    backgroundColor: '#9E9E9E'
    collapsed: true
    argument: 'tile=risk&mode=collapsed&notify=false&log=shared&risk_api=null&local_geoapi=baidu&remote_geoapi=ipapi-zh&mask_ip=0&tw_flag=cn&stash_options={"risk_api":${args.risk_api|json},"local_geoapi":${args.local_geoapi|json},"remote_geoapi":${args.remote_geoapi|json},"mask_ip":${args.mask_ip|json},"tw_flag":${args.tw_flag|json}}'

# 通知使用日常分流，不受长按测试节点影响；需要 Stash 保持连接。
cron:
  script:
    - name: hotkids-ip-security
      cron: '* * * * *'
      timeout: 5
      argument: 'task=logs'
    - name: hotkids-ip-security-notify
      cron: '*/10 * * * *'
      timeout: 25
      argument: 'task=monitor&notify=true&log=shared&risk_api=null&local_geoapi=baidu&remote_geoapi=ipapi-zh&mask_ip=0&tw_flag=cn&stash_options={"risk_api":${args.risk_api|json},"local_geoapi":${args.local_geoapi|json},"remote_geoapi":${args.remote_geoapi|json},"mask_ip":${args.mask_ip|json},"tw_flag":${args.tw_flag|json},"notify":${args.notify|json},"stash_api":${args.stash_api|json},"stash_api_url":${args.stash_api_url|json},"stash_api_secret":${args.stash_api_secret|json}}'

script-providers:
  hotkids-ip-security:
    url: https://raw.githubusercontent.com/HotKids/Rules/refs/heads/master/Surge/Module/Scripts/ip-security.js
    interval: 86400
  hotkids-ip-security-summary:
    url: https://raw.githubusercontent.com/HotKids/Rules/refs/heads/master/Surge/Module/Scripts/ip-security.js
    interval: 86400
  hotkids-ip-security-outbound:
    url: https://raw.githubusercontent.com/HotKids/Rules/refs/heads/master/Surge/Module/Scripts/ip-security.js
    interval: 86400
  hotkids-ip-security-local:
    url: https://raw.githubusercontent.com/HotKids/Rules/refs/heads/master/Surge/Module/Scripts/ip-security.js
    interval: 86400
  hotkids-ip-security-risk:
    url: https://raw.githubusercontent.com/HotKids/Rules/refs/heads/master/Surge/Module/Scripts/ip-security.js
    interval: 86400
  hotkids-ip-security-notify:
    url: https://raw.githubusercontent.com/HotKids/Rules/refs/heads/master/Surge/Module/Scripts/ip-security.js
    interval: 86400
