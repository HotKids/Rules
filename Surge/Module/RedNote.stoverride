name: 小红书去广告
desc: 小红书去广告，部分 App 需清除缓存或重新安装后才会生效
author: fmz200
category: 去广告
homepage: https://github.com/fmz200/wool_scripts
http:
  mitm:
  - edith.xiaohongshu.com
  - www.xiaohongshu.com
  - ci.xiaohongshu.com
  - rec.xiaohongshu.com
  - so.xiaohongshu.com
  mock:
  - match: ^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/surprisebox\/(?:get_style|open|submit_action)
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https?:\/\/www\.xiaohongshu\.com\/api\/marketing\/box\/trigger\?
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/guide\?
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/detailfeed\/preload\?
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/guide\/user_banner
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https?:\/\/www\.xiaohongshu\.com\/api\/sns\/(v\d+\/ads\/resource|v\d+\/hey\/\w+\/hey_gallery)
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https?:\/\/ci\.xiaohongshu\.com\/system_config\/watermark
    base64: R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7
    status-code: 200
    headers:
      Content-Type: image/gif
  script:
  - name: RedNote-小红书搜索页
    match: ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/(banner|hot)_list
    type: response
    require-body: true
    timeout: 60.0
  - name: RedNote-小红书搜索页__2
    match: ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/(hint|trending)\?
    type: response
    require-body: true
    timeout: 60.0
  - name: RedNote-小红书搜索页__3
    match: ^https?:\/\/(so|edith)\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/notes\?
    type: response
    require-body: true
    timeout: 60.0
  - name: RedNote-小红书开屏广告
    match: ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/config\?
    type: response
    require-body: true
    timeout: 60.0
  - name: RedNote-小红书开屏广告__2
    match: ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/splash_config
    type: response
    require-body: true
    timeout: 60.0
  - name: RedNote-小红书详情页
    match: ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/widgets
    type: response
    require-body: true
    timeout: 60.0
  - name: RedNote-小红书图片视频水印
    match: ^https?:\/\/(edith|rec|www)\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/(imagefeed|live_photo\/save)
    type: response
    require-body: true
    timeout: 60.0
  - name: RedNote-小红书图片视频水印__2
    match: ^https?:\/\/(edith|rec|www)\.xiaohongshu\.com\/api\/sns\/v\d+\/(followfeed|homefeed)\?
    type: response
    require-body: true
    timeout: 60.0
  - name: RedNote-小红书图片视频水印__3
    match: ^https?:\/\/(edith|rec|www)\.xiaohongshu\.com\/api\/sns\/(v2\/note\/feed|v3\/note\/videofeed)\?
    type: response
    require-body: true
    timeout: 60.0
  - name: RedNote-小红书图片视频水印__4
    match: ^https?:\/\/(edith|rec|www)\.xiaohongshu\.com\/api\/sns\/(v4\/note\/videofeed|v10\/note\/video\/save)\?
    type: response
    require-body: true
    timeout: 60.0
  - name: RedNote-小红书评论区去水印存储
    match: ^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(v5\/note\/comment\/list|v3\/note\/comment\/sub_comments)\?
    type: response
    require-body: true
    timeout: 60.0
  - name: RedNote-小红书评论区去水印下载
    match: ^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/interaction\/comment\/video\/download\?
    type: response
    require-body: true
    timeout: 60.0
