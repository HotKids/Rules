# Generated by .github/scripts/module_convert.py; edit sync-rules.txt instead.
### fork from https://raw.githubusercontent.com/xingjiu29/Umetrip/main/umetrip.plugin

[Rule]
DOMAIN,sensors.umetrip.com.cn,REJECT
DOMAIN,analytics.umetrip.com,REJECT

[Script]
response if ${url} ~ = /^https?:\/\/(bkclient|umerp|home|umehome)\.umetrip\.com(\.cn)?\/gateway\/api\/umetrip\/native(?:\?.*)?$/i then script("https://raw.githubusercontent.com/xingjiu29/Umetrip/refs/heads/main/umetrip.js") with timeout=30, requires_body=true, binary_body_mode=true

[Rewrite]
^https?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native - reject
^https?:\/\/oss\.umetrip\.com\/fs\/advert\/polite - reject-dict

[MitM]
hostname = %APPEND% umerp.umetrip.com, umerp.umetrip.com.cn, home.umetrip.com, bkclient.umetrip.com.cn, discardrp.umetrip.com, startup.umetrip.com, oss.umetrip.com, umehome.umetrip.com
