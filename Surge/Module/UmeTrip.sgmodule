#!name=航旅纵横去广告
#!desc=精简首页、精简我的页面\n规则参考 zirawell/Ad-Cleaner
#!author=杏九
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/da/75/f6/da75f662-e6f4-20db-777b-a047ca7dd497/AppIcon-0-0-1x_U007emarketing-0-7-0-85-220.png/512x512bb.jpg
#!category=去广告

# Generated by .github/scripts/module_convert.py; edit sync-rules.txt instead.
### fork from https://raw.githubusercontent.com/xingjiu29/Umetrip/main/umetrip.plugin

[Rule]
DOMAIN,sensors.umetrip.com.cn,REJECT,extended-matching,pre-matching
DOMAIN,analytics.umetrip.com,REJECT,extended-matching,pre-matching

[URL Rewrite]
^https?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native - reject

[Map Local]
^https?:\/\/oss\.umetrip\.com\/fs\/advert\/polite data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
航旅纵横去广告_1 = type=http-response, pattern=(?i)^https?:\/\/(bkclient|umerp|home|umehome|sns|appmsg)\.umetrip\.com(\.cn)?\/gateway\/api\/umetrip\/native(?:\?.*)?$, script-path=https://raw.githubusercontent.com/HotKids/Rules/refs/heads/master/Surge/Module/Scripts/umetrip.js, requires-body=true, binary-body-mode=true, timeout=30, engine=webview

[MITM]
hostname = %APPEND% umerp.umetrip.com, umerp.umetrip.com.cn, home.umetrip.com, bkclient.umetrip.com.cn, discardrp.umetrip.com, startup.umetrip.com, oss.umetrip.com, umehome.umetrip.com, sns.umetrip.com, appmsg.umetrip.com
