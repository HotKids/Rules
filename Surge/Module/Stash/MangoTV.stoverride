  - ^https?:\/\/dc\d?\.bz\.mgtv\.com\/dynamic\/v\d\/channel\/index\/\w response-jq .data |= map(select(.moduleEntityId != "10579" and .moduleEntityId != "9686")) | .moduleIDS |= map(select(.moduleEntityId != "10579" and .moduleEntityId != "9686"))
  - ^https:\/\/mobile-thor\.api\.mgtv\.com\/v\d+\/vod\/info\? response-jq delpaths([["data","config","ad"]])
  - ^https:\/\/mobile-thor\.api\.mgtv\.com\/v\d+\/vod\/info\? response-jq delpaths([["data","config","vipNav"]])
  - ^https:\/\/mobile-thor\.api\.mgtv\.com\/v\d+\/vod\/info\? response-jq delpaths([["data","template","skinList"]])
  - ^https:\/\/mobile-thor\.api\.mgtv\.com\/v\d+\/vod\/info\? response-jq delpaths([["data","template","theme"]])
  - ^https:\/\/mobile-thor\.api\.mgtv\.com\/v\d+\/vod\/info\? response-jq .data.tabs |= map(select(.name == "视频" or .name == "讨论")) | .data.template.modules |= map(if .clipInfo.ext?.ipPublishEntrance then .clipInfo |= del(.ext) else . end) | .data.template.modules |= map(select(.dataType == 101 or .dataType == 201)) | .data.template.modules |= map(.media.list |= (if type == "array" then map(select(.type != 0)) else . end))
  - ^https:\/\/comment\.mgtv\.com\/v\d\/comment\/getCommentList\? response-jq .data.list |= map(select(.type == 0))
