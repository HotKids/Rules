  - ^https?:\/\/mobile\.api\.(mgtv|hunantv)\.com\/mobile\/config\? response-jq if (getpath(["data"]) | has("playerUseHttpDNS")) then (setpath(["data","playerUseHttpDNS"]; 0)) else . end
