  - ^https?:\/\/mobile\.api\.(mgtv|hunantv)\.com\/mobile\/config\? response-jq if (getpath(["data"]) | has("damang_duanju_tab")) then (setpath(["data","damang_duanju_tab"]; 0)) else . end
  - ^https?:\/\/mobile\.api\.(mgtv|hunantv)\.com\/mobile\/config\? response-jq if (getpath(["data"]) | has("playview_box_ad_switch")) then (setpath(["data","playview_box_ad_switch"]; 0)) else . end
