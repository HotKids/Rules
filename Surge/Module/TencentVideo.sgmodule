腾讯视频去广告_3 = type=http-response,pattern=^https?:\/\/iacc\.qq\.com\/(?:\?.*)?$,requires-body=true,max-size=4194304,script-path=https://raw.githubusercontent.com/HotKids/Rules/refs/heads/master/Surge/Module/Scripts/tencentvideo.js
腾讯视频去广告_4 = type=http-response,pattern=^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$,requires-body=true,max-size=4194304,script-path=https://raw.githubusercontent.com/HotKids/Rules/refs/heads/master/Surge/Module/Scripts/tencentvideo.js
