name: 微博去广告
desc: 微博去广告，部分 App 需清除缓存或重新安装后才会生效
author: fmz200
icon: https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/Weibo-00.png
category: 去广告
homepage: https://github.com/fmz200/wool_scripts
date: '2025-12-16 21:33:23'
http:
  mitm:
  - '*.weibo.cn'
  - '*.weibo.com'
  - weibo.com
  url-rewrite:
  - ^https?:\/\/api\.weibo\.cn\/2\/(push\/active|client\/addlog_batch|ad\/preload) - reject-200
  - ^https?:\/\/api-cloudim\.api\.weibo\.com\/v1\/log\/ - reject-200
  - ^https?:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/(get-lbs-cell-info\.php|sdkconfig\.php) - reject
  - ^https:\/\/api\.weibo\.cn\/2\/logservice\/service\? - reject
  body-rewrite:
  - ^https:\/\/api\.weibo\.cn\/2\/cardlist\? response-jq del(.items[] | select(.category == "group"))
  - ^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=trends& response-jq del(.data.banner)
  mock:
  - match: ^https?:\/\/api\.weibo\.c(n|om)\/\d\/(cardlist\?v_f=\d|ad\/weibointl\?)
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php\?a=hot_search_users
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php\?a=get_searching_info
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php\?a=treehole&auth=
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https?:\/\/m?api\.weibo\.c(n|om)\/\d/push\/daily
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https?:\/\/m?api\.weibo\.c(n|om)\/2\/!\/huati\/(discovery_home_bottom_getdotinfo|mobile_discovery_searchchange)\?
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https?:\/\/bootrealtime\.uve\.weibo\.com\/v\d\/ad\/realtime
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https?:\/\/bootpreload\.uve\.weibo\.com\/v\d\/ad\/preload
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https:\/\/card\.weibo\.com\/article\/m\/aj\/(reward|uvead)\?
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https:\/\/weibo\.com\/ttarticle\/x\/m\/aj\/(reward|uvead)\?
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https:\/\/m?api\.weibo\.c(n|om)\/2\/!\/huati\/discovery_home_bottom_channels
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https:\/\/m?api\.weibo\.c(n|om)\/2\/!\/chaohua\/discovery\/home_bottom\/switch
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https:\/\/m?api\.weibo\.c(n|om)\/2\/!\/was\/finder\/searchbarchange\?
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  - match: ^https:\/\/m?api\.weibo\.c(n|om)\/2\/push\/info\?
    text: '{}'
    status-code: 200
    headers:
      Content-Type: application/json
  script:
  - name: Weibo-微博移除发现页广告
    match: ^https?:\/\/m?api\.weibo\.c(n|om)\/2\/search\/(finder|container_timeline|container_discover)\?
    type: response
    require-body: true
    timeout: 60.0
  - name: Weibo-微博热搜页面广告
    match: ^https?:\/\/m?api\.weibo\.c(n|om)\/2\/(page|flowpage)\?
    type: response
    require-body: true
    timeout: 60.0
  - name: Weibo-微博话题页面广告
    match: ^https?:\/\/m?api\.weibo\.c(n|om)\/2\/searchall\?
    type: response
    require-body: true
    timeout: 60.0
  - name: Weibo-微博超话页面广告
    match: ^https?:\/\/m?api\.weibo\.c(n|om)\/2\/statuses\/container_timeline_topicpage\?
    type: response
    require-body: true
    timeout: 60.0
  - name: Weibo-微博超话tab页净化
    match: ^https?:\/\/m?api\.weibo\.c(n|om)\/2\/statuses\/container_timeline_topic\?
    type: response
    require-body: true
    timeout: 60.0
  - name: Weibo-微博详情页面广告
    match: ^https?:\/\/m?api\.weibo\.c(n|om)\/2\/statuses\/extend\?
    type: response
    require-body: true
    timeout: 60.0
  - name: Weibo-微博详情页面广告__2
    match: ^https?:\/\/m?api\.weibo\.c(n|om)\/2\/statuses\/container_detail\?
    type: response
    require-body: true
    timeout: 60.0
  - name: Weibo-微博最顶部的tab页分组
    match: ^https?:\/\/m?api\.weibo\.c(n|om)\/2\/groups\/allgroups\/v2
    type: response
    require-body: true
    timeout: 60.0
  - name: Weibo-微博评论区广告
    match: ^https?:\/\/m?api\.weibo\.c(n|om)\/2\/comments\/mix_comments\?
    type: response
    require-body: true
    timeout: 60.0
  - name: Weibo-微博评论区广告__2
    match: ^https?:\/\/m?api\.weibo\.c(n|om)\/2\/statuses\/(container_detail_comment|container_detail_mix)\?
    type: response
    require-body: true
    timeout: 60.0
  - name: Weibo-微博转发区广告
    match: ^https?:\/\/m?api\.weibo\.c(n|om)\/2\/statuses\/container_detail_forward\?
    type: response
    require-body: true
    timeout: 60.0
  - name: Weibo-微博转发区广告__2
    match: ^https?:\/\/m?api\.weibo\.c(n|om)\/2\/statuses\/repost_timeline\?
    type: response
    require-body: true
    timeout: 60.0
  - name: Weibo-微博去广告以及去除各部分推广模块
    match: ^https?:\/\/m?api\.weibo\.c(n|om)/2/(cardlist|searchall|page|messageflow|statuses/(unread_)?friends(/|_)timeline|groups/timeline|statuses/(container_timeline|container_timeline_hot|unread_hot_timeline|extend|video_mixtimeline)|profile/(me|container_timeline)|video/(community_tab|remind_info|tiny_stream_video_list)|checkin/show|(\!/)?live/media_homelist|comments/build_comments|container/get_item)
    type: response
    require-body: true
    timeout: 60.0
  - name: Weibo-微博去广告以及去除各部分推广模块__2
    match: ^https?:\/\/(sdk|wb)app\.uve\.weibo\.com(/interface/sdk/sdkad.php|/wbapplua/wbpullad.lua)
    type: response
    require-body: true
    timeout: 60.0
  - name: Weibo-自定义tab皮肤
    match: ^https?:\/\/m?api\.weibo\.c(n|om)\/2\/!\/client\/light_skin
    type: response
    require-body: true
    timeout: 60.0
  - name: Weibo-非会员设置tab皮肤
    match: ^https?:\/\/new\.vip\.weibo\.c(n|om)\/littleskin\/preview
    type: response
    require-body: true
    timeout: 60.0
  - name: Weibo-解锁微博会员APP图标
    match: ^https?:\/\/new\.vip\.weibo\.c(n|om)\/aj\/appicon\/list
    type: response
    require-body: true
    timeout: 60.0
script-providers:
  Weibo-微博移除发现页广告:
